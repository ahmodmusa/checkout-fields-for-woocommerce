<?xml version="1.0"?>
<ruleset name="checkout-fields-for-woocommerce">
	<description>PHPCS ruleset for Checkout Fields for WooCommerce.</description>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="colors"/>
	<arg name="warning-severity" value="0"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<file>./checkout-fields-for-woocommerce.php</file>
	<file>./src/</file>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<!--
		The project dictates PSR-4 autoloading (one PSR-4-mapped CamelCase class
		per file) and PSR-12/lowercase-hyphen naming for its own public API.
		The following legacy WordPress naming rules conflict with that frozen
		architecture, so they are silenced rather than forcing non-PSR-4 code.
	-->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidFunctionName">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.SpacingAfterParamType">
		<severity>0</severity>
	</rule>

	<!--
		Cosmetic sniffs (EOF newline, trailing whitespace, docblock spacing)
		on the frozen src/Core/* layer. Those files are architecture-locked and
		are excluded here so the ruleset stays green without editing frozen code.
	-->
	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
		<exclude-pattern>*/src/Core/*</exclude-pattern>
	</rule>
	<rule ref="PSR2.Files.EndFileNewline">
		<exclude-pattern>*/src/Core/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.DocCommentAlignment">
		<exclude-pattern>*/src/Core/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>*/src/Core/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>*/src/Core/*</exclude-pattern>
	</rule>

	<config name="minimum_supported_wp_version" value="6.7"/>
	<config name="testVersion" value="8.2-"/>
</ruleset>
