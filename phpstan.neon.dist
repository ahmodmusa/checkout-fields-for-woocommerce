includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    paths:
        - checkout-fields-for-woocommerce.php
        - src/
        - tests/
    phpVersion: 80200
    tmpDir: .phpstan
    checkMissingIterableValueType: false
    treatPhpDocTypesAsCertain: false
